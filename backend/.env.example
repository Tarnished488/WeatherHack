# Copy these values into your deployment environment or export them before
# starting the API. Never commit a real key or email credential file.
MAJIGUARD_CONDUIT_ENDPOINT=https://<official-conduit-endpoint>
MAJIGUARD_CONDUIT_API_KEY=[REDACTED_SECRET]
MAJIGUARD_CONDUIT_EMAIL=your-team-email@example.com

# Optional: DeepSeek LLM for flexible advice on /api/llm-advice.
# Without a key the endpoint serves the fixed rule-engine templates.
# NOTE: the LLM call uses httpx, which honours the standard proxy variables.
# If direct access to api.deepseek.com is blocked on your network, export
# HTTPS_PROXY / HTTP_PROXY (e.g. http://127.0.0.1:7897) before starting the
# API; the advice layer degrades to templates on any proxy or HTTP error.
MAJIGUARD_DEEPSEEK_API_KEY=[REDACTED_SECRET]
MAJIGUARD_DEEPSEEK_BASE_URL=https://api.deepseek.com
MAJIGUARD_DEEPSEEK_MODEL=deepseek-chat
MAJIGUARD_LLM_TIMEOUT_SECONDS=30

# Optional settings for the local demo.
MAJIGUARD_DB=data/majiguard.db
MAJIGUARD_CORS_ORIGINS=http://localhost:5173
